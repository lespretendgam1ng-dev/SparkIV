<Window
    x:Class="SparkIV.WinUI.Rdr2SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="12,0,0,0">
            <TextBlock Text="Set up Red Dead Redemption 2 - SparkIV" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The steps, like an installer -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,1,0" CornerRadius="0,8,0,0">
                <StackPanel Padding="16,20,12,16" Spacing="6">
                    <TextBlock Text="Red Dead Redemption 2" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="One-time setup" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="StepList" Spacing="2" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1">
                <Grid x:Name="Pages" Padding="28,20,28,12" />
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Margin="24,8,24,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Click="Cancel_Click" />
            <Button x:Name="BackButton" Grid.Column="2" Content="Back" MinWidth="96" Click="Back_Click" />
            <Button x:Name="NextButton" Grid.Column="3" Content="Next" MinWidth="96" Click="Next_Click" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
